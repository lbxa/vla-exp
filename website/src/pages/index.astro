---
const reportTitle = "VLA-RLX: Reinforcement Learning for Vision-Language Action Models";
const reportType = "VLA-RLX Undergraduate Honours Thesis";
const reportDate = "Nov 28th, 2025";

const authors = ["Lucas Barbosa"];

const summaryParagraphs = [
  "VLA-RLX explores how reinforcement learning can adapt vision-language action models for reliable robot behavior in constrained and noisy settings.",
  "The project focuses on lightweight adaptation pipelines that preserve policy quality while reducing inference cost and deployment latency for practical lab workflows.",
];
---

<html lang="en" class="bg-stone-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="VLA-RLX research homepage." />
    <meta name="generator" content={Astro.generator} />
    <title>VLA-RLX Research</title>
  </head>
  <body class="bg-stone-50">
    <main class="grid min-h-screen grid-rows-[auto_1fr] bg-stone-50">
      <div class="z-10 mb-[15.5rem] grid auto-rows-min grid-cols-[1fr_min(80rem,100%-1rem)_1fr] bg-stone-50">
        <div class="col-start-2 min-w-0 pt-8 md:pt-12">
          <div class="relative mx-auto max-w-3xl">
            <header class="mb-12 pt-20">
              <div class="mb-14 space-y-2 text-center text-xs">
                <svg
                  viewBox="0 0 22 12"
                  aria-hidden="true"
                  class="mx-auto mb-4 block h-3 w-auto text-sm leading-none text-stone-800"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M6 1.5C3.51 1.5 1.5 3.51 1.5 6C1.5 8.49 3.51 10.5 6 10.5C8.2 10.5 9.98 8.95 11 7C12.02 8.95 13.8 10.5 16 10.5C18.49 10.5 20.5 8.49 20.5 6C20.5 3.51 18.49 1.5 16 1.5C13.8 1.5 12.02 3.05 11 5C9.98 3.05 8.2 1.5 6 1.5Z"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <p class="uppercase">{reportType}</p>
                <p>{reportDate}</p>
              </div>

              <hr class="mb-0 w-full border-t-4 border-stone-950" />
              <h1 class="py-10 text-center text-4xl font-light tracking-tight [text-wrap:balance]">
                {reportTitle}
              </h1>
              <hr class="w-full border-t-2 border-stone-950" />

              <div class="mt-16 items-center gap-8 md:grid md:grid-cols-2">
                <div class="space-y-4">
                  <div class="mb-4 space-y-1.5 text-sm text-stone-600">
                    {
                      authors.map((author) => (
                        <p>
                          <span class="font-medium text-stone-900 underline underline-offset-4">
                            {author}
                          </span>{" "}
                        </p>
                      ))
                    }
                  </div>

                  {
                    summaryParagraphs.map((paragraph) => (
                      <p class="text-justify text-sm text-stone-600">{paragraph}</p>
                    ))
                  }
                </div>

                <div class="hidden md:block">
                  <div class="w-full rounded-lg border border-stone-200 bg-gradient-to-br from-stone-100 via-white to-stone-200 p-6">
                    <div class="aspect-[4/3] w-full rounded-md border border-stone-300 bg-stone-50" />
                  </div>
                </div>
              </div>
            </header>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
